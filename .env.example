# Copie para apps/api/.env e ajuste. Todas as variáveis têm o prefixo FORJA_.
FORJA_DATA_DIR=../../.dev-data
# FORJA_DATABASE_URL=postgresql+psycopg://forja:forja@localhost:5432/forja   # padrão: SQLite em FORJA_DATA_DIR
FORJA_MAX_UPLOAD_MB=500
FORJA_PREVIEW_TIMEOUT_S=15
FORJA_DUCKDB_MEMORY_LIMIT=2GB
FORJA_DUCKDB_THREADS=4
FORJA_CACHE_MAX_GB=2
# Token de acesso (como no Flowa). Sem FORJA_TOKEN, a API gera um em <data_dir>/token no primeiro start.
# `uv run python -m forja.cli token` mostra o endereço com #token=.
# FORJA_TOKEN=
# FORJA_WEB_URL=http://localhost:5173
# Desligar o login: a API passa a atender só conexões desta máquina.
# FORJA_AUTH_ENABLED=true

# Arquivos: local (padrão) ou s3 (bucket S3-compatível, ex. MinIO; `uv sync --extra s3`).
# O disco continua sendo a cópia de trabalho (o DuckDB só lê arquivos locais); o bucket é o armazenamento durável.
# FORJA_STORAGE=s3
# FORJA_S3_BUCKET=forja
# FORJA_S3_PREFIX=forja
# FORJA_S3_ENDPOINT_URL=http://localhost:9000
# FORJA_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=forja
# AWS_SECRET_ACCESS_KEY=forja-minio
# FORJA_S3_CREATE_BUCKET=true   # só em dev: cria o bucket se não existir
