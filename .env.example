# Copie para apps/api/.env e ajuste. Todas as variáveis têm o prefixo FORJA_.
FORJA_DATA_DIR=../../.dev-data
# FORJA_DATABASE_URL=postgresql+psycopg://forja:forja@localhost:5432/forja   # padrão: SQLite em FORJA_DATA_DIR
FORJA_MAX_UPLOAD_MB=500
FORJA_PREVIEW_TIMEOUT_S=15
FORJA_DUCKDB_MEMORY_LIMIT=2GB
FORJA_DUCKDB_THREADS=4
FORJA_CACHE_MAX_GB=2
