# Copie para apps/api/.env e ajuste. Todas as variáveis têm o prefixo SOWA_.
SOWA_DATA_DIR=../../.dev-data
# SOWA_DATABASE_URL=postgresql+psycopg://sowa:sowa@localhost:5432/sowa   # padrão: SQLite em SOWA_DATA_DIR
SOWA_MAX_UPLOAD_MB=500
SOWA_PREVIEW_TIMEOUT_S=15
SOWA_DUCKDB_MEMORY_LIMIT=2GB
SOWA_DUCKDB_THREADS=4
SOWA_CACHE_MAX_GB=2
# Exportações prontas são apagadas depois de N dias (0 = guardar para sempre).
# SOWA_EXPORT_RETENTION_DAYS=7
# Token de acesso (como no Flowa). Sem SOWA_TOKEN, a API gera um em <data_dir>/token no primeiro start.
# `uv run python -m sowa.cli token` mostra o endereço com #token=.
# SOWA_TOKEN=
# SOWA_WEB_URL=http://localhost:5173
# Desligar o login: a API passa a atender só conexões desta máquina.
# SOWA_AUTH_ENABLED=true
# A API serve a interface compilada (apps/web/dist) em /, como no `make start`.
# SOWA_SERVE_WEB=true
# SOWA_WEB_DIST=../web/dist

# Arquivos: local (padrão) ou s3 (bucket S3-compatível, ex. MinIO; `uv sync --extra s3`).
# O disco continua sendo a cópia de trabalho (o DuckDB só lê arquivos locais); o bucket é o armazenamento durável.
# SOWA_STORAGE=s3
# SOWA_S3_BUCKET=sowa
# SOWA_S3_PREFIX=sowa
# SOWA_S3_ENDPOINT_URL=http://localhost:9000
# SOWA_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=sowa
# AWS_SECRET_ACCESS_KEY=sowa-minio
# SOWA_S3_CREATE_BUCKET=true   # só em dev: cria o bucket se não existir
