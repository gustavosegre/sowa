// SOWA formula grammar (Excel-like). Operator precedence follows Excel:
// negation > percent > ^ > * / > + - > & > comparisons.
// ARGSEP and the decimal separator inside NUMBER are injected per locale by parser.py.

?start: expr

?expr: comparison

?comparison: concat
    | comparison COMPOP concat         -> binary

?concat: additive
    | concat AMP additive              -> binary

?additive: mult
    | additive ADDOP mult              -> binary

?mult: power
    | mult MULOP power                 -> binary

?power: percent
    | power POW percent                -> binary

?percent: unary
    | percent PCT                      -> percent

?unary: atom
    | ADDOP unary                      -> unary

?atom: NUMBER                          -> number
    | STRING                           -> string
    | COLUMN                           -> column
    | PARAM                            -> param
    | NAME LPAR [args] RPAR            -> call
    | NAME                             -> name
    | LPAR expr RPAR                   -> group

args: expr (ARGSEP expr)*

COMPOP: "<>" | "<=" | ">=" | "=" | "<" | ">"
AMP: "&"
ADDOP: "+" | "-"
MULOP: "*" | "/"
POW: "^"
PCT: "%"
LPAR: "("
RPAR: ")"

STRING: /"([^"]|"")*"/
COLUMN: /\[([^\]]|\]\])*\]/
PARAM: /\{[^{}]+\}/
NAME: /[A-Za-z_À-ɏ][A-Za-z0-9_.À-ɏ]*/

%import common.WS
%ignore WS
